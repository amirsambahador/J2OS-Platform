<?xml version="1.0" encoding="UTF-8"?>
<!--
    Sample process 3: leave automation. Fully automated version of leaveRequest: both
    steps are service tasks (server-side Java delegates), so a single startProcess call
    runs the whole thing to completion with no user task waiting on approval.
-->
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:flowable="http://flowable.org/bpmn"
                  xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
                  id="leaveAutomationDefinitions" targetNamespace="http://j2os.org/jbpms">
    <!-- The process id doubles as its deployment key: JFlow refers to this process by "leaveAutomation". -->
    <bpmn:process id="leaveAutomation" name="LeaveAutomation" isExecutable="true">
        <bpmn:startEvent id="start" name="Start">
            <bpmn:outgoing>c1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="c1" sourceRef="start" targetRef="calculateDeduction"/>

        <!-- Input: variable "days" | Output: variable "deductionAmount" -->
        <bpmn:serviceTask id="calculateDeduction" name="calculateDeduction"
                          flowable:class="org.j2os.examples.desktop.jflow.server.delegate.CalculateLeaveDeductionDelegate">
            <bpmn:incoming>c1</bpmn:incoming>
            <bpmn:outgoing>c2</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="c2" sourceRef="calculateDeduction" targetRef="buildSummary"/>

        <!-- Input: variable "deductionAmount" (output of the previous step) | Output: variable "summaryMessage" -->
        <bpmn:serviceTask id="buildSummary" name="buildSummary"
                          flowable:class="org.j2os.examples.desktop.jflow.server.delegate.BuildLeaveSummaryDelegate">
            <bpmn:incoming>c2</bpmn:incoming>
            <bpmn:outgoing>c3</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="c3" sourceRef="buildSummary" targetRef="end"/>

        <bpmn:endEvent id="end" name="End">
            <bpmn:incoming>c3</bpmn:incoming>
        </bpmn:endEvent>
    </bpmn:process>
</bpmn:definitions>